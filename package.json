{
  "name": "campusbridge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CampusBridge AI: budgeting, tuition savings, simulated cross-border transfers and a confirmation-based assistant for international students.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js --reset-demo --seed-only",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "node e2e/walkthrough.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"shared/**/*.js\" \"tests/**/*.js\"",
    "dev:watch": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch-path=server --watch-path=shared server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
