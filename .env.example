# Copy to .env and adjust. Never commit .env.
PORT=8787
HOST=127.0.0.1
# SQLite file (created automatically). Delete it to start over.
DATABASE_PATH=data/campusbridge.db
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# Send the session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Browser origins allowed to call the API in development (Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
# Create the fictional demo account on startup. Set to false outside demos.
SEED_DEMO=true
